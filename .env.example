# Description: Environment variables template for local development and deployment.
# Need: Secrets/config (project IDs, API keys) must never be hardcoded or committed.
# Motive: Give developers a copy-and-fill template so onboarding is fast while
#         keeping actual credentials out of version control.

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GEMINI_API_KEY=your-gemini-api-key

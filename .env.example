# Description: Environment variables template for local development and deployment.
# Need: Secrets/config (project IDs, API keys) must never be hardcoded or committed.
# Motive: Give developers a copy-and-fill template so onboarding is fast while
#         keeping actual credentials out of version control.

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GEMINI_API_KEY=your-gemini-api-key
# GCP API key for the Cloud Billing Catalog API (cloudbilling.googleapis.com/v1).
# Used by CostScalingAgent to fetch live SKU prices. No billing account needed —
# enable "Cloud Billing API" in your GCP project and create an API key in
# APIs & Services > Credentials. Without this key, hardcoded fallback rates are used.
GCP_API_KEY=your-gcp-api-key
